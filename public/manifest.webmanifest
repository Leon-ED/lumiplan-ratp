{
    "id": "/",
    "start_url": "/?source=pwa",
    "name": "Écran Lumiplan RATP",
    "short_name": "Lumiplan",
    "description": "Affichez la desserte en temps réel de n'importe quelle ligne d'Île-de-France ou créez votre propre écran bus personnalisé.",
    "lang": "fr-FR",
    "dir": "ltr",
    "scope": "/",
    "launch_handler": {
        "client_mode": "navigate-existing"
    },
    "display": "standalone",
